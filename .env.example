# =====================================================================
# Silvia & Manuel 2027 — variabili d'ambiente
#
# Copia questo file in `.env.local` e riempi i valori.
# `.env.local` NON deve mai finire su Git (è già in .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Database (Postgres)
#
# Funziona con qualsiasi Postgres gestito: Vercel Postgres, Neon,
# Supabase, Railway...
#
# Vercel Postgres / Neon: creato lo store dalla dashboard, le variabili
# arrivano da sole con `vercel env pull .env.local`.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
# (usare la porta 6543, quella con pooling).
# ---------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------
# Area admin (/admin)
#
# ADMIN_PASSWORD  password per accedere all'elenco RSVP.
# ADMIN_SESSION_SECRET  stringa casuale lunga usata per firmare il
#                       cookie di sessione. Generane una con:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Nessuna delle due è esposta al browser: non hanno il prefisso
# NEXT_PUBLIC_ e vengono lette solo lato server.
# ---------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------
# Sale per l'hash degli IP usati nel rate limiting degli invii RSVP.
# Una stringa casuale qualsiasi. Se cambia, i contatori ripartono.
# ---------------------------------------------------------------------
RSVP_IP_SALT=

# ---------------------------------------------------------------------
# URL pubblico del sito, usato per metadata, Open Graph e sitemap.
# In locale: http://localhost:3000
# In produzione: https://silviaemanuel.it
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
