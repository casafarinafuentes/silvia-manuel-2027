# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# metadati macOS (AppleDouble): si creano copiando il progetto
# da/verso volumi non-HFS e inquinano il working tree su Windows
._*
.Spotlight-V100
.Trashes

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tranne il template, che contiene solo i NOMI delle variabili
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA visivo (screenshot, report) — generato da scripts/qa-screenshots.mjs
.qa/

.vercel
.env*

# password admin generata localmente, mai da versionare
.admin-password.txt
